---
// Delt «forstørr bilde»-overlay. Alle elementer med attributtet data-full
// (stor bilde-URL) blir trykkbare og åpner dette i stor versjon.
interface Props {
  closeLabel?: string;
}
const { closeLabel = 'Close' } = Astro.props;
---

<dialog class="lightbox" id="lightbox" aria-label={closeLabel}>
  <button class="lb-close" type="button" data-lb-close aria-label={closeLabel}>
    <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true">
      <path
        d="M6 6l12 12M18 6L6 18"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"></path>
    </svg>
  </button>
  <img class="lb-img" alt="" />
</dialog>

<script is:inline>
  (function () {
    var dlg = document.getElementById('lightbox');
    if (!dlg) return;
    var img = dlg.querySelector('.lb-img');

    function open(src, alt) {
      img.src = src;
      img.alt = alt || '';
      if (typeof dlg.showModal === 'function') dlg.showModal();
      else dlg.setAttribute('open', '');
      requestAnimationFrame(function () {
        dlg.classList.add('open');
      });
    }
    function close() {
      dlg.classList.remove('open');
      img.src = '';
      if (typeof dlg.close === 'function') dlg.close();
      else dlg.removeAttribute('open');
    }

    document.addEventListener('click', function (e) {
      var trigger = e.target.closest('[data-full]');
      if (trigger) {
        e.preventDefault();
        open(trigger.getAttribute('data-full'), trigger.getAttribute('data-full-alt'));
        return;
      }
      // Klikk på bakgrunn eller lukkeknapp lukker.
      if (e.target === dlg || (e.target.closest && e.target.closest('[data-lb-close]'))) {
        close();
      }
    });
    // Escape (native dialog) – rydd opp klassen.
    dlg.addEventListener('cancel', function () {
      dlg.classList.remove('open');
      img.src = '';
    });
  })();
</script>

<style>
  .lightbox {
    max-width: 100vw;
    max-height: 100vh;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    border: none;
    background: transparent;
    overflow: hidden;
    place-items: center;
  }
  .lightbox[open] {
    display: grid;
  }
  .lightbox::backdrop {
    background: rgba(0, 0, 0, 0.88);
  }
  .lb-img {
    max-width: 94vw;
    max-height: 90vh;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 8px;
    box-shadow: 0 12px 50px rgba(0, 0, 0, 0.5);
    /* Kjapp inn-animasjon */
    transform: scale(0.92);
    opacity: 0;
    transition:
      transform 0.18s ease,
      opacity 0.18s ease;
  }
  .lightbox.open .lb-img {
    transform: scale(1);
    opacity: 1;
  }
  .lb-close {
    position: fixed;
    top: 1rem;
    right: 1rem;
    z-index: 2;
    display: inline-flex;
    padding: 0.5rem;
    border: 0;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.5);
    color: #fff;
    cursor: pointer;
  }
  .lb-close:hover {
    background: rgba(0, 0, 0, 0.75);
  }
  @media (prefers-reduced-motion: reduce) {
    .lb-img {
      transition: none;
      transform: none;
      opacity: 1;
    }
  }
</style>
