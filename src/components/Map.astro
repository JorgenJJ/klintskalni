---
interface Props {
  title: string;
  areaLabel: string;
  linkLabel: string;
  lat: number;
  lon: number;
  areaSpan: number;
  showMarker: boolean;
}

const { title, areaLabel, linkLabel, lat, lon, areaSpan, showMarker } = Astro.props;

// Beregn et bbox-utsnitt rundt punktet. Standard viser nærområdet (se kap. 2.8),
// ikke nøyaktig adresse. Eksakt nål kun hvis showMarker = true.
const half = areaSpan;
const left = (lon - half).toFixed(5);
const right = (lon + half).toFixed(5);
const bottom = (lat - half / 2).toFixed(5);
const top = (lat + half / 2).toFixed(5);

const embed = new URL('https://www.openstreetmap.org/export/embed.html');
embed.searchParams.set('bbox', `${left},${bottom},${right},${top}`);
embed.searchParams.set('layer', 'mapnik');
if (showMarker) embed.searchParams.set('marker', `${lat},${lon}`);

const fullMap = `https://www.openstreetmap.org/#map=12/${lat}/${lon}`;
---

<section class="map" id="map" aria-label={title}>
  <div class="container">
    {title && <h2 class="section-title">{title}</h2>}
    {areaLabel && <p class="area">{areaLabel}</p>}
    <div class="frame">
      <iframe
        title={`${title} – OpenStreetMap`}
        src={embed.href}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>
    {
      linkLabel && (
        <p class="more">
          <a href={fullMap} target="_blank" rel="noopener noreferrer">
            {linkLabel} →
          </a>
        </p>
      )
    }
  </div>
</section>

<style>
  .area {
    color: var(--muted);
    margin-top: -0.75rem;
  }
  .frame {
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
    aspect-ratio: 16 / 9;
    background: var(--border);
  }
  iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
  .more {
    margin-top: 1rem;
  }
  .more a {
    font-weight: 600;
  }
</style>
