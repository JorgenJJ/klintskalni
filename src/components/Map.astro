---
interface Props {
  title: string;
  areaLabel: string;
  linkLabel: string;
  lat: number;
  lon: number;
  areaSpan: number;
  showMarker: boolean;
}

const { title, areaLabel, linkLabel, lat, lon, areaSpan, showMarker } = Astro.props;

// Beregn et bbox-utsnitt rundt punktet. Standard viser nærområdet (se kap. 2.8),
// ikke nøyaktig adresse. Eksakt nål kun hvis showMarker = true.
const half = areaSpan;
const left = (lon - half).toFixed(5);
const right = (lon + half).toFixed(5);
const bottom = (lat - half / 2).toFixed(5);
const top = (lat + half / 2).toFixed(5);

const embed = new URL('https://www.openstreetmap.org/export/embed.html');
embed.searchParams.set('bbox', `${left},${bottom},${right},${top}`);
embed.searchParams.set('layer', 'mapnik');
if (showMarker) embed.searchParams.set('marker', `${lat},${lon}`);

const fullMap = `https://www.openstreetmap.org/#map=12/${lat}/${lon}`;
---

<section class="map" id="map" aria-label={title}>
  <div class="container">
    {title && <h2 class="section-title">{title}</h2>}
    {areaLabel && <p class="area">{areaLabel}</p>}
    <div class="frame">
      <iframe
        title={`${title} – OpenStreetMap`}
        src={embed.href}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"></iframe>
      {/* Fanger scroll så siden ikke «låser seg» i kartet. Slippes gjennom
          når Ctrl holdes, eller etter et klikk (for å dra kartet). */}
      <div class="scroll-guard" aria-hidden="true"></div>
    </div>
    {
      linkLabel && (
        <p class="more">
          <a href={fullMap} target="_blank" rel="noopener noreferrer">
            {linkLabel} →
          </a>
        </p>
      )
    }
  </div>
</section>

<style>
  .area {
    color: var(--muted);
    margin-top: -0.75rem;
  }
  .frame {
    position: relative;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
    aspect-ratio: 16 / 9;
    background: var(--border);
  }
  /* Ligger over kartet og tar imot scroll. Slås av ved å legge til .active. */
  .scroll-guard {
    position: absolute;
    inset: 0;
  }
  .frame.active .scroll-guard {
    pointer-events: none;
  }
  iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
  .more {
    margin-top: 1rem;
  }
  .more a {
    font-weight: 600;
  }
</style>

<script>
  // Kartet skal ikke stjele scrollen. Vaktlaget over iframen slippes gjennom
  // bare når Ctrl holdes (zoom), eller etter et klikk (for å dra kartet).
  document.querySelectorAll<HTMLElement>('.map .frame').forEach((frame) => {
    const release = () => frame.classList.remove('active');

    frame.addEventListener(
      'wheel',
      (e) => {
        if (e.ctrlKey) {
          // Uten dette zoomer nettleseren hele siden i stedet for kartet.
          e.preventDefault();
          frame.classList.add('active');
        } else {
          release();
        }
      },
      { passive: false },
    );

    frame.addEventListener('click', () => frame.classList.add('active'));
    frame.addEventListener('mouseleave', release);
    // Scroll havner i iframen når vakta er av, så Ctrl-slipp fanges globalt.
    document.addEventListener('keyup', (e) => {
      if (e.key === 'Control') release();
    });
  });
</script>
