---
import { languages, type Lang } from '../i18n/languages';
import { localizedPath } from '../i18n/utils';
import Flag from './Flag.astro';

interface Props {
  current: Lang;
  available: Lang[];
  label: string;
}

const { current, available, label } = Astro.props;
---

<nav class="langbar" aria-label={label}>
  {
    available.map((lang) => (
      <a
        href={localizedPath(lang)}
        hreflang={lang}
        lang={lang}
        data-lang={lang}
        class:list={['flaglink', { active: lang === current }]}
        aria-label={languages[lang]}
        aria-current={lang === current ? 'true' : undefined}
        title={languages[lang]}
      >
        <Flag lang={lang} />
      </a>
    ))
  }
</nav>

<style>
  .langbar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .flaglink {
    display: inline-flex;
    padding: 0.35rem;
    border-radius: 9px;
    border: 2px solid transparent;
    line-height: 0;
    opacity: 0.5;
    filter: grayscale(0.5);
    transition:
      opacity 0.15s ease,
      filter 0.15s ease,
      border-color 0.15s ease,
      background-color 0.15s ease;
  }
  .flaglink:hover {
    opacity: 1;
    filter: none;
  }
  /* Aktivt språk: full farge, ramme og lett bakgrunn – tydelig markert */
  .flaglink.active {
    opacity: 1;
    filter: none;
    border-color: var(--brand);
    background: #eef4f3;
    cursor: default;
  }
  /* Flaggene er hovedkontrollen nå – gjør dem godt synlige */
  .flaglink :global(.flag) {
    width: 2.3rem;
    height: calc(2.3rem * 0.68);
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.12) inset;
  }
  @media (prefers-reduced-motion: reduce) {
    .flaglink {
      transition: none;
    }
  }
</style>
