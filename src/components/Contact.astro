---
interface Props {
  title: string;
  text: string;
  airbnbUrl: string;
  airbnbLabel: string;
  email: string;
  emailLabel: string;
}

const { title, text, airbnbUrl, airbnbLabel, email, emailLabel } = Astro.props;
---

<section class="contact" id="contact" aria-label={title}>
  <div class="container narrow">
    {title && <h2 class="section-title">{title}</h2>}
    {text && <p class="lead">{text}</p>}
    <div class="actions">
      <a class="btn btn-primary" href={airbnbUrl} target="_blank" rel="noopener noreferrer">
        {airbnbLabel}
      </a>
      {
        email && (
          <a class="btn btn-secondary" href={`mailto:${email}`}>
            {emailLabel}
          </a>
        )
      }
    </div>
  </div>
</section>

<style>
  .contact {
    background: var(--brand);
    color: #fff;
  }
  .narrow {
    max-width: 60ch;
    text-align: center;
  }
  .contact .section-title {
    color: #fff;
  }
  .lead {
    font-size: 1.15rem;
    margin-bottom: 1.75rem;
  }
  .actions {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  /* Sørg for nok kontrast på sekundærknapp mot grønn bakgrunn */
  .contact .btn-secondary {
    background: #fff;
    border-color: #fff;
  }
</style>
