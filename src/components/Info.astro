---
interface Props {
  title: string;
  emailNote?: string;
  email?: string;
}

const { title, emailNote, email } = Astro.props;
---

<section class="info" id="info">
  <div class="container">
    {title && <h2 class="section-title">{title}</h2>}
    <div class="prose">
      {/* Lengre informasjonstekst kommer fra markdown-brødteksten i sections/<lang>.md */}
      <slot />
    </div>
    {
      emailNote && email && (
        <p class="book-email">
          {emailNote} <a href={`mailto:${email}`}>{email}</a>
        </p>
      )
    }
  </div>
</section>

<style>
  /* Full bredde, venstrejustert – flukter med de andre seksjonene */
  .prose :global(p) {
    margin: 0 0 1rem;
    font-size: 1.12rem;
  }
  .prose :global(p:last-child) {
    margin-bottom: 0;
  }
  .book-email {
    margin: 1.25rem 0 0;
    font-size: 1.12rem;
  }
  .book-email a {
    color: var(--brand-dark);
    font-weight: 600;
  }
</style>
