---
import { Image } from 'astro:assets';
import { resolveImage } from '../lib/images';

interface House {
  id: string;
  airbnbUrl: string;
  image: string;
  name: string;
  tagline: string;
  keyPoints: { icon: string; label: string }[];
  description: string;
  bookLabel: string;
  imageAlt: string;
}

interface Props {
  title: string;
  intro: string;
  houses: House[];
}

const { title, intro, houses } = Astro.props;
---

<section class="houses" id="houses" aria-label={title}>
  <div class="container">
    {title && <h2 class="section-title">{title}</h2>}
    {intro && <p class="intro">{intro}</p>}

    <div class="grid">
      {
        houses.map((house) => {
          const img = resolveImage(house.image);
          return (
            <article class="card">
              {img && (
                <div class="media">
                  <Image
                    src={img}
                    alt={house.imageAlt}
                    widths={[400, 700, 1000]}
                    sizes="(max-width: 760px) 100vw, 480px"
                    loading="lazy"
                  />
                </div>
              )}
              <div class="body">
                <h3>{house.name}</h3>
                {house.tagline && <p class="tagline">{house.tagline}</p>}

                {house.keyPoints.length > 0 && (
                  <ul class="points">
                    {house.keyPoints.map((p) => (
                      <li>
                        <span class="icon" aria-hidden="true">
                          {p.icon}
                        </span>
                        <span>{p.label}</span>
                      </li>
                    ))}
                  </ul>
                )}

                {house.description && <p class="desc">{house.description}</p>}

                <a
                  class="btn btn-primary"
                  href={house.airbnbUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {house.bookLabel}
                </a>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .intro {
    max-width: 60ch;
    margin: -0.5rem 0 2rem;
    color: var(--muted);
    font-size: 1.1rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
    align-items: stretch;
  }
  .card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
  }
  .media {
    aspect-ratio: 3 / 2;
    background: var(--border);
  }
  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 1.5rem;
    flex: 1;
  }
  h3 {
    margin: 0;
    font-size: 1.5rem;
  }
  .tagline {
    margin: -0.5rem 0 0;
    color: var(--brand-dark);
    font-weight: 600;
  }
  .points {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem 1rem;
  }
  .points li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.95rem;
  }
  .points .icon {
    font-size: 1.2rem;
    line-height: 1;
  }
  .desc {
    margin: 0;
    color: var(--text);
  }
  /* Knappen forankres nederst, så begge kort blir like høye */
  .body .btn {
    margin-top: auto;
    align-self: flex-start;
  }
</style>
