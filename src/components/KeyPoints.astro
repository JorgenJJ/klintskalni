---
interface Props {
  title: string;
  points: { icon: string; label: string }[];
}

const { title, points } = Astro.props;
---

{
  points.length > 0 && (
    <section class="keypoints" aria-label={title}>
      <div class="container">
        {title && <h2 class="section-title">{title}</h2>}
        <ul class="points">
          {points.map((p) => (
            <li>
              <span class="icon" aria-hidden="true">
                {p.icon}
              </span>
              <span class="label">{p.label}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<style>
  .points {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 1rem;
  }
  li {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.5rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.5rem 1rem;
    box-shadow: var(--shadow);
  }
  .icon {
    font-size: 2rem;
    line-height: 1;
  }
  .label {
    font-weight: 600;
  }
</style>
