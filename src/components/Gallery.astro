---
import { Image } from 'astro:assets';
import { resolveImage } from '../lib/images';

interface Props {
  title: string;
  files: string[];
  alts: string[];
}

const { title, files, alts } = Astro.props;

const items = files
  .map((file, i) => ({ image: resolveImage(file), alt: alts[i] ?? '' }))
  .filter((item) => item.image);
---

{
  items.length > 0 && (
    <section class="gallery" id="gallery" aria-label={title}>
      <div class="container">
        {title && <h2 class="section-title">{title}</h2>}
        <div class="grid">
          {items.map((item) => (
            <figure>
              <Image
                src={item.image!}
                alt={item.alt}
                widths={[320, 640, 960]}
                sizes="(max-width: 640px) 100vw, (max-width: 1080px) 50vw, 360px"
                loading="lazy"
              />
            </figure>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 0.75rem;
  }
  figure {
    margin: 0;
    border-radius: var(--radius);
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--border);
    box-shadow: var(--shadow);
  }
  figure :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  figure:hover :global(img) {
    transform: scale(1.03);
  }
  @media (prefers-reduced-motion: reduce) {
    figure :global(img) {
      transition: none;
    }
  }
</style>
