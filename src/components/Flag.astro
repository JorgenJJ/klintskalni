---
// Små, innebygde SVG-flagg per språk. SVG i stedet for emoji-flagg fordi
// emoji-flagg ikke vises på Windows. Mangler et språk et flagg, vises et
// nøytralt globus-ikon (så nye språk aldri «brekker» headeren).
import type { Lang } from '../i18n/languages';

interface Props {
  lang: string;
  class?: string;
}

const { lang, class: className } = Astro.props;

// Map språkkode -> landflagg. Legg til nye språk her ved behov.
const flags: Partial<Record<Lang | string, 'no' | 'gb' | 'lv'>> = {
  no: 'no',
  en: 'gb',
  lv: 'lv',
};

const flag = flags[lang];

// Unik id per instans, så flere flagg på samme side ikke kolliderer.
const uid = `uk-${Math.random().toString(36).slice(2, 9)}`;
---

<span class:list={['flag', className]} aria-hidden="true">
  {
    flag === 'no' && (
      <svg viewBox="0 0 22 16" role="img">
        <rect width="22" height="16" fill="#ba0c2f" />
        <rect x="6" width="4" height="16" fill="#fff" />
        <rect y="6" width="22" height="4" fill="#fff" />
        <rect x="7" width="2" height="16" fill="#00205b" />
        <rect y="7" width="22" height="2" fill="#00205b" />
      </svg>
    )
  }
  {
    flag === 'lv' && (
      <svg viewBox="0 0 22 16" role="img">
        <rect width="22" height="16" fill="#9e3039" />
        <rect y="6.4" width="22" height="3.2" fill="#fff" />
      </svg>
    )
  }
  {
    flag === 'gb' && (
      <svg viewBox="0 0 60 30" role="img">
        <clipPath id={uid}>
          <rect width="60" height="30" />
        </clipPath>
        <g clip-path={`url(#${uid})`}>
          <rect width="60" height="30" fill="#012169" />
          <path d="M0,0 60,30 M60,0 0,30" stroke="#fff" stroke-width="6" />
          <path
            d="M0,0 60,30 M60,0 0,30"
            stroke="#C8102E"
            stroke-width="4"
            clip-path={`url(#${uid})`}
          />
          <path d="M30,0 V30 M0,15 H60" stroke="#fff" stroke-width="10" />
          <path d="M30,0 V30 M0,15 H60" stroke="#C8102E" stroke-width="6" />
        </g>
      </svg>
    )
  }
  {
    !flag && (
      <svg viewBox="0 0 16 16" role="img">
        <circle cx="8" cy="8" r="7" fill="none" stroke="currentColor" stroke-width="1.3" />
        <path
          d="M1 8h14M8 1c2.5 2 2.5 12 0 14M8 1c-2.5 2-2.5 12 0 14"
          fill="none"
          stroke="currentColor"
          stroke-width="1.3"
        />
      </svg>
    )
  }
</span>

<style>
  .flag {
    display: inline-flex;
    width: 1.25rem;
    height: calc(1.25rem * 0.7);
    flex: 0 0 auto;
    border-radius: 2px;
    overflow: hidden;
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.1) inset;
    line-height: 0;
  }
  .flag svg {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>
