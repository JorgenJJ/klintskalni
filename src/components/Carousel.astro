---
import { Image, getImage } from 'astro:assets';
import { resolveImage } from '../lib/images';

interface Props {
  title: string;
  files: string[];
  alts: string[];
}

const { title, files, alts } = Astro.props;

// Løs opp bildene og lag en stor versjon (for «forstørr»-visning).
const base = [];
for (let i = 0; i < files.length; i++) {
  const im = resolveImage(files[i]);
  if (!im) continue;
  const full = await getImage({ src: im, width: 1600, format: 'webp' });
  base.push({ im, alt: alts[i] ?? '', full: full.src });
}

const n = base.length;
const TILE = 240; // px, omtrentlig flisbredde på desktop
const SEC_PER_TILE = 7; // sakte fart; lik for begge rader (samme px/sek)

// Bygg fliser for én rad: gjenta settet nok til å fylle skjermen, deretter to
// like grupper etter hverandre => sømløs -50%-loop.
function buildRow(items: typeof base) {
  const per = items.length ? Math.max(2, Math.ceil(2400 / (items.length * TILE))) : 0;
  const group = [];
  for (let r = 0; r < per; r++) group.push(...items);
  const tiles = [...group, ...group];
  const duration = group.length * SEC_PER_TILE;
  return { tiles, duration };
}

// Fordel bildene på tvers av radene: 1 oppe, 2 nede, 3 oppe, 4 nede …
const topBase = base.filter((_, i) => i % 2 === 0);
const bottomBase = base.filter((_, i) => i % 2 === 1);

// Rad 2 forskyves en halv flis i fase (brick-mønster). Halv flis = SEC_PER_TILE/2.
const rows = [
  { ...buildRow(topBase), uniques: topBase.length, delay: 0 },
  { ...buildRow(bottomBase), uniques: bottomBase.length, delay: -SEC_PER_TILE / 2 },
];
---

{
  n > 0 && (
    <section class="carousel-sec" aria-label={title}>
      <div class="container">
        <h2 class="section-title">{title}</h2>
        <div class="marquee">
          {rows.map((row) => (
          <div class="marquee-row">
            <ul class="marquee-track" style={`--dur:${row.duration}s; animation-delay:${row.delay}s`}>
              {row.tiles.map((t, i) => {
                const exposed = i < row.uniques;
                return (
                  <li aria-hidden={exposed ? undefined : 'true'}>
                    <button
                      class="zoomable"
                      type="button"
                      data-full={t.full}
                      data-full-alt={t.alt}
                      aria-label={exposed ? t.alt : undefined}
                      tabindex={exposed ? 0 : -1}
                    >
                      <Image
                        src={t.im}
                        alt={exposed ? t.alt : ''}
                        widths={[240, 480]}
                        sizes="260px"
                        loading="lazy"
                      />
                    </button>
                  </li>
                );
              })}
            </ul>
          </div>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .carousel-sec {
    overflow: hidden;
  }
  .marquee {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    margin-top: 1.5rem;
    /* Karusellen er like bred som innholdet (i .container) og toner mykt ut i
       kantene. Bredere gradient + mellomstopp gir en mykere overgang. */
    --fade: clamp(48px, 16%, 200px);
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0,
      rgba(0, 0, 0, 0.5) calc(var(--fade) * 0.5),
      #000 var(--fade),
      #000 calc(100% - var(--fade)),
      rgba(0, 0, 0, 0.5) calc(100% - var(--fade) * 0.5),
      transparent 100%
    );
    mask-image: linear-gradient(
      to right,
      transparent 0,
      rgba(0, 0, 0, 0.5) calc(var(--fade) * 0.5),
      #000 var(--fade),
      #000 calc(100% - var(--fade)),
      rgba(0, 0, 0, 0.5) calc(100% - var(--fade) * 0.5),
      transparent 100%
    );
  }
  .marquee-row {
    overflow: hidden;
  }
  .marquee-track {
    display: flex;
    gap: 0.7rem;
    width: max-content;
    margin: 0;
    padding: 0;
    list-style: none;
    animation: marquee var(--dur, 80s) linear infinite;
  }
  /* Stopp når pekeren holdes over karusellen */
  .marquee:hover .marquee-track {
    animation-play-state: paused;
  }
  .marquee-track > li {
    flex: 0 0 auto;
  }
  .zoomable {
    display: block;
    width: clamp(170px, 24vw, 260px);
    aspect-ratio: 3 / 2;
    padding: 0;
    border: 0;
    border-radius: 12px;
    overflow: hidden;
    background: var(--border);
    box-shadow: var(--shadow);
    cursor: zoom-in;
  }
  .zoomable :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }
  .zoomable:hover :global(img) {
    transform: scale(1.05);
  }
  @keyframes marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
  /* Uttoningen vises kun på brede skjermer – droppes på mobil */
  @media (max-width: 768px) {
    .marquee {
      -webkit-mask-image: none;
      mask-image: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
    .marquee-row {
      overflow-x: auto;
    }
    .zoomable:hover :global(img) {
      transform: none;
    }
  }
</style>
