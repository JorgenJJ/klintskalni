---
// Rot-URL ("/"): standardspråk er engelsk. Har brukeren tidligere valgt et
// språk (lagret lokalt), sendes de dit i stedet.
import { defaultLang, locales } from '../i18n/languages';
import { getAvailableLangs } from '../i18n/utils';

const availableLangs = await getAvailableLangs();
const fallback = `/${defaultLang}/`;
---

<!doctype html>
<html lang={defaultLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Klintskalni 1</title>
    <link rel="canonical" href={fallback} />
    {/* Uten JavaScript: gå til standardspråket (engelsk). */}
    <meta http-equiv="refresh" content={`0; url=${fallback}`} />
    <script
      is:inline
      define:vars={{ available: availableLangs, fallback, supported: locales }}
    >
      try {
        var saved = localStorage.getItem('klLang');
        if (saved && supported.includes(saved) && available.includes(saved)) {
          window.location.replace('/' + saved + '/');
        } else {
          window.location.replace(fallback);
        }
      } catch (e) {
        window.location.replace(fallback);
      }
    </script>
  </head>
  <body>
    <p>Redirecting… <a href={fallback}>Continue</a></p>
  </body>
</html>
