---
import { render } from 'astro:content';
import { getImage } from 'astro:assets';
import { type Lang } from '../../i18n/languages';
import { getAvailableLangs, getSection, localizedPath } from '../../i18n/utils';
import { resolveImage } from '../../lib/images';
// Felles innstillinger (eiendomsnavn + kart) – samme for alle språk.
import { site } from '../../lib/site';
import reviewsData from '../../content/reviews/reviews.json';
// Bilder er felles for alle språk (kun alt-tekst oversettes – se sections).
import media from '../../data/media.json';
// De to husene: felles data (bilde + Airbnb-lenke), koblet med tekst per språk.
import housesData from '../../data/houses.json';
// E-post er felles for alle språk.
import contact from '../../data/contact.json';
// «I nærheten»: felles stedsdata. Navnene er egennavn og oversettes aldri.
import { assertProperNounsIntact, buildNearbyGroups, protectedNames } from '../../lib/nearby';
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import Houses from '../../components/Houses.astro';
import Carousel from '../../components/Carousel.astro';
import Info from '../../components/Info.astro';
import Reviews from '../../components/Reviews.astro';
import Map from '../../components/Map.astro';
import Nearby from '../../components/Nearby.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import Contact from '../../components/Contact.astro';
import Lightbox from '../../components/Lightbox.astro';

const reviews = reviewsData.reviews;
const email = contact.email;

// Én statisk side per språk – drevet av den sentrale språklisten.
export async function getStaticPaths() {
  const langs = await getAvailableLangs();
  return langs.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const availableLangs = await getAvailableLangs();
const sectionEntry = await getSection(lang);
const s = sectionEntry.data;
const { Content } = await render(sectionEntry);

// Slå sammen felles husdata (houses.json) med oversatt tekst (sections) via id.
const houses = housesData.houses
  .map((h) => {
    const t = s.houses.items.find((x) => x.id === h.id);
    return t ? { ...h, ...t } : null;
  })
  .filter((h): h is NonNullable<typeof h> => h !== null);

// Slå sammen felles stedsdata (nearby.json) med oversatt tekst (sections) via id.
const nearbyGroups = buildNearbyGroups(s.nearby.categoryLabels, s.nearby.items);

// Sveltia lagrer bare feltene den kjenner fra config.yml. Har man /admin åpen i
// en fane som ble lastet FØR et nytt felt kom til, blir feltet stille strøket
// ved neste lagring. Det skjedde med lenketeksten under, som da forsvant uten
// spor. Nå stopper bygget i stedet, med beskjed om hva som må gjøres.
if (!s.nearby.linkLabel && nearbyGroups.some((g) => g.items.some((i) => i.url))) {
  throw new Error(
    `nearby.linkLabel mangler i src/content/sections/${lang}.md, men det finnes ` +
      'steder med lenke. Last /admin på nytt (Ctrl+F5) slik at CMS-et henter ' +
      'oppdatert config.yml, og fyll inn lenketeksten igjen.',
  );
}

// Stedsnavn ligger i nearby.json og kan derfor ikke maskinoversettes. Feltene
// under MÅ være oversatt og nevner likevel stedsnavn, så de sjekkes ved bygg
// for at diakritiske tegn ikke har falt bort (Tūja → Tuja).
assertProperNounsIntact(protectedNames, [
  s.nearby.intro,
  s.general.mapAreaLabel,
  s.general.seoTitle,
  s.general.seoDescription,
  ...s.nearby.items.map((item) => item.description),
]);

// Innholdsmenyen gjenbruker seksjonstitlene, så den har ingen egne tekster å
// oversette. Rekkefølgen må matche seksjonene på siden.
const tocItems = [
  { href: '#info', label: s.about.title },
  { href: '#houses', label: s.houses.title },
  // Karusellen står bevisst ikke i menyen: den har ingen synlig overskrift,
  // så et punkt dit ville pekt på noe leseren ikke ser navnet på.
  { href: '#nearby', label: s.nearby.title },
  { href: '#reviews', label: s.general.reviewsTitle },
  { href: '#map', label: s.general.mapTitle },
  { href: '#contact', label: s.general.contactTitle },
];

// «Les alle anmeldelser» peker til huset (primær annonse).
const reviewsUrl =
  housesData.houses.find((h) => h.id === 'house')?.airbnbUrl ??
  housesData.houses[0]?.airbnbUrl ??
  '';

// Strukturerte data (schema.org) – hjelper Google/AI å forstå at dette er to
// utleieenheter ved stranden i Tūja / Liepupe, Limbaži, Latvia.
const canonicalUrl = Astro.site ? new URL(localizedPath(lang), Astro.site).href : undefined;
const heroMeta = resolveImage(media.heroImage);
let imageUrl: string | undefined;
if (heroMeta && Astro.site) {
  const opt = await getImage({ src: heroMeta, width: 1200, format: 'jpg' });
  imageUrl = new URL(opt.src, Astro.site).href;
}
const reviewCount = reviews.length;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LodgingBusiness',
  name: site.houseName,
  description: s.general.seoDescription,
  ...(canonicalUrl ? { url: canonicalUrl } : {}),
  ...(imageUrl ? { image: imageUrl } : {}),
  ...(email ? { email } : {}),
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Tūja',
    addressRegion: 'Limbaži Municipality',
    addressCountry: 'LV',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: site.map.lat,
    longitude: site.map.lon,
  },
  petsAllowed: true,
  amenityFeature: [
    { '@type': 'LocationFeatureSpecification', name: 'Beach access', value: true },
    { '@type': 'LocationFeatureSpecification', name: 'Sauna', value: true },
    { '@type': 'LocationFeatureSpecification', name: 'Pets allowed', value: true },
    { '@type': 'LocationFeatureSpecification', name: 'Free parking', value: true },
    { '@type': 'LocationFeatureSpecification', name: 'Playground', value: true },
  ],
  containsPlace: houses.map((h) => ({
    '@type': 'Accommodation',
    name: h.name,
    ...(h.guests
      ? { occupancy: { '@type': 'QuantitativeValue', value: h.guests, unitText: 'guests' } }
      : {}),
    ...(h.bedrooms ? { numberOfBedrooms: h.bedrooms } : {}),
    url: h.airbnbUrl,
  })),
  ...(reviewCount > 0
    ? {
        aggregateRating: {
          '@type': 'AggregateRating',
          ratingValue: '5',
          reviewCount: String(reviewCount),
        },
      }
    : {}),
};
---

<Layout
  lang={lang}
  houseName={site.houseName}
  title={s.general.seoTitle}
  description={s.general.seoDescription}
  ogImageName={media.ogImage}
  availableLangs={availableLangs}
  languageLabel={s.general.languageLabel}
  skipToContentLabel={s.general.skipToContent}
  jsonLd={jsonLd}
>
  <Hero
    image={resolveImage(media.heroImage)}
    alt={s.hero.alt}
    title={s.hero.title}
    tagline={s.hero.tagline}
    ctaHref="#houses"
    ctaLabel={s.hero.ctaLabel}
  />

  <TableOfContents label={s.general.tocLabel} items={tocItems} />

  <Info title={s.about.title} emailNote={s.about.emailNote} email={email}>
    <Content />
  </Info>

  <Houses
    title={s.houses.title}
    houses={houses}
    photosLabel={s.houses.photosButtonLabel}
    closeLabel={s.houses.closeLabel}
  />

  <Carousel
    title={s.general.galleryTitle}
    files={media.gallery}
    alts={s.general.galleryAlts}
  />

  <Nearby
    title={s.nearby.title}
    intro={s.nearby.intro}
    linkLabel={s.nearby.linkLabel}
    groups={nearbyGroups}
    lang={lang}
  />

  <Reviews
    title={s.general.reviewsTitle}
    note={s.general.reviewsNote}
    linkLabel={s.general.reviewsLinkLabel}
    airbnbUrl={reviewsUrl}
    reviews={reviews}
  />

  <Map
    title={s.general.mapTitle}
    areaLabel={s.general.mapAreaLabel}
    linkLabel={s.general.mapLinkLabel}
    lat={site.map.lat}
    lon={site.map.lon}
    areaSpan={site.map.areaSpan}
    showMarker={site.map.showMarker}
  />

  <Contact
    title={s.general.contactTitle}
    text={s.general.contactText}
    email={email}
    emailLabel={s.general.emailButtonLabel}
  />

  <Lightbox
    closeLabel={s.houses.closeLabel}
    prevLabel={s.houses.prevImageLabel}
    nextLabel={s.houses.nextImageLabel}
  />
</Layout>
