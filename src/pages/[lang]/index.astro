---
import { render } from 'astro:content';
import { type Lang } from '../../i18n/languages';
import { getAvailableLangs, getSection, getSite } from '../../i18n/utils';
import { resolveImage } from '../../lib/images';
import reviewsData from '../../content/reviews/reviews.json';
// Bilder er felles for alle språk (kun alt-tekst oversettes – se sections).
import media from '../../data/media.json';
// De to husene: felles data (bilde + Airbnb-lenke), koblet med tekst per språk.
import housesData from '../../data/houses.json';
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import Houses from '../../components/Houses.astro';
import Gallery from '../../components/Gallery.astro';
import Info from '../../components/Info.astro';
import Reviews from '../../components/Reviews.astro';
import Map from '../../components/Map.astro';
import Contact from '../../components/Contact.astro';

const reviews = reviewsData.reviews;

// Én statisk side per språk – drevet av den sentrale språklisten.
export async function getStaticPaths() {
  const langs = await getAvailableLangs();
  return langs.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const availableLangs = await getAvailableLangs();
const site = await getSite(lang);
const sectionEntry = await getSection(lang);
const s = sectionEntry.data;
const { Content } = await render(sectionEntry);

// Slå sammen felles husdata (houses.json) med oversatt tekst (sections) via id.
const houses = housesData.houses
  .map((h) => {
    const t = s.houses.find((x) => x.id === h.id);
    return t ? { ...h, ...t } : null;
  })
  .filter((h): h is NonNullable<typeof h> => h !== null);

// «Les alle anmeldelser» peker til huset (primær annonse).
const reviewsUrl =
  housesData.houses.find((h) => h.id === 'house')?.airbnbUrl ??
  housesData.houses[0]?.airbnbUrl ??
  '';
---

<Layout
  lang={lang}
  houseName={site.houseName}
  title={s.seoTitle}
  description={s.seoDescription}
  ogImageName={media.ogImage}
  availableLangs={availableLangs}
  languageLabel={s.languageLabel}
  skipToContentLabel={s.skipToContent}
>
  <Hero
    image={resolveImage(media.heroImage)}
    alt={s.heroAlt}
    title={s.heroTitle}
    tagline={s.heroTagline}
    ctaHref="#houses"
    ctaLabel={s.heroCtaLabel}
  />

  <Info title={s.infoTitle}>
    <Content />
  </Info>

  <Houses
    title={s.housesTitle}
    intro={s.housesIntro}
    houses={houses}
    photosLabel={s.photosButtonLabel}
    closeLabel={s.closeLabel}
  />

  <Gallery title={s.galleryTitle} files={media.gallery} alts={s.galleryAlts} />

  <Reviews
    title={s.reviewsTitle}
    note={s.reviewsNote}
    linkLabel={s.reviewsLinkLabel}
    airbnbUrl={reviewsUrl}
    reviews={reviews}
  />

  <Map
    title={s.mapTitle}
    areaLabel={s.mapAreaLabel}
    linkLabel={s.mapLinkLabel}
    lat={site.map.lat}
    lon={site.map.lon}
    areaSpan={site.map.areaSpan}
    showMarker={site.map.showMarker}
  />

  <Contact
    title={s.contactTitle}
    text={s.contactText}
    email={site.email}
    emailLabel={s.emailButtonLabel}
  />
</Layout>
